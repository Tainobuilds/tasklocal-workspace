# Stripe test keys — copy this file to .env.local and fill in your own values.
# Without them the booking flow still runs; the payment step shows a clearly
# labelled "Stripe is not configured" state instead of taking a payment.
# Find these at https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
