# Copy this file to .env.local and fill in your own values.

# Supabase — backs listings and bookings (the provider/customer data layer).
# Without them, Supabase-backed routes log a warning and degrade gracefully
# (empty listings/bookings, 503 on writes) instead of crashing the app.
# Find these at https://app.supabase.com → your project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic — powers Claude-based matching/assistant features.
# Find this at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe test keys — without them the booking flow still runs; the payment
# step shows a clearly labelled "Stripe is not configured" state instead of
# taking a payment. Find these at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
